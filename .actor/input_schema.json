{
  "title": "Naukri.com Job Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchQuery": {
      "title": "Search Query",
      "type": "string",
      "description": "Job title or keywords to search for (e.g., 'software engineer', 'data analyst')",
      "editor": "textfield",
      "default": "software engineer"
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "Location to filter jobs (e.g., 'bangalore', 'mumbai', 'delhi')",
      "editor": "textfield",
      "default": ""
    },
    "experience": {
      "title": "Experience Level",
      "type": "string",
      "description": "Experience requirement (e.g., '0-3', '3-5', '5-10')",
      "editor": "textfield",
      "default": ""
    },
    "maxResults": {
      "title": "Maximum Results",
      "type": "integer",
      "description": "Maximum number of job listings to scrape",
      "editor": "number",
      "default": 100,
      "minimum": 1,
      "maximum": 1000
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for the scraper. Use Apify Proxy for best results.",
      "editor": "proxy",
      "default": {
        "useApifyProxy": true
      }
    }
  },
  "required": []
}
